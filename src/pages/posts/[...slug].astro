---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('cs-CZ', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const description = post.data.excerpt ?? post.data.title;
---
<Layout
  title={`${post.data.title} — Volba pro Broumov`}
  description={description}
  image={post.data.image ?? '/Jaroslav_Bitnar.png'}
  type="article"
  publishedTime={post.data.date.toISOString()}
>

  <article class="post-detail">
    <div class="container container--reading">

      <a href="/#prispevky" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Zpět na příspěvky
      </a>

      <header class="post-detail-header">
        <time class="post-detail-date" datetime={post.data.date.toISOString()}>
          {formattedDate}
        </time>
        <h1 class="post-detail-title">{post.data.title}</h1>
      </header>

      {post.data.image && (
        <div class="post-detail-image-wrap">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="post-detail-image"
            loading="eager"
          />
        </div>
      )}

      <div class="post-detail-body">
        <Content />
      </div>

      <div class="post-detail-footer">
        <a href="/#prispevky" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Zpět na příspěvky
        </a>
      </div>

    </div>
  </article>

</Layout>

<style>
  .container--reading {
    max-width: var(--max-width-reading);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .post-detail {
    padding: 3rem 0 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 2rem;
    transition: color var(--transition);
  }
  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-primary);
  }

  .post-detail-header {
    margin-bottom: 1.75rem;
  }
  .post-detail-date {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .post-detail-title {
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.25;
  }

  .post-detail-image-wrap {
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .post-detail-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-detail-body {
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .post-detail-body p {
    margin-bottom: 1.1rem;
    text-align: justify;
  }
  .post-detail-body p:last-child {
    margin-bottom: 0;
  }
  .post-detail-body strong {
    color: var(--color-primary);
  }
  .post-detail-body h2 {
    color: var(--color-primary);
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    line-height: 1.3;
  }
  .post-detail-body h3 {
    color: var(--color-primary);
    font-size: 1.2rem;
    margin: 1.5rem 0 0.75rem;
  }
  .post-detail-body ul,
  .post-detail-body ol {
    margin: 0 0 1.1rem 1.5rem;
  }
  .post-detail-body li {
    margin-bottom: 0.4rem;
  }
  .post-detail-body a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .post-detail-body blockquote {
    border-left: 4px solid var(--color-secondary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-detail-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .post-detail-footer .back-link {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .post-detail {
      padding: 2rem 0 3rem;
    }
    .post-detail-title {
      font-size: 1.6rem;
    }
    .post-detail-body p {
      text-align: left;
    }
  }
</style>
